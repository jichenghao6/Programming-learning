# ============================================================
# 多语言学习仓库通用 .gitignore
# 作用：列出的文件/文件夹不会被 Git 上传到 GitHub
# 以 # 开头的行是注释，不生效；不需要某个语言的规则可直接删掉
# ============================================================


# ---------- 操作系统自动生成的文件（所有系统通用，建议保留）----------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# macOS
.DS_Store
# Linux
*~


# ---------- 编辑器 / IDE 自动生成的配置 ----------
# VS Code（若想保留你的编辑器设置，可删掉这行）
.vscode/
# Visual Studio
.vs/
# JetBrains 系列（CLion、PyCharm、IntelliJ IDEA 等）
.idea/
*.iml
# 其他常见编辑器
*.swp
*.swo


# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
# 虚拟环境
venv/
env/
.venv/
ENV/
# 打包/分发产物
build/
dist/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
# 环境变量与密钥（不要上传密码！）
.env
.env.local


# ---------- C / C++ ----------
# 编译生成的目标文件、可执行文件
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.exe
*.out
*.app
# 调试文件
*.pdb
# 编译数据库/构建目录
cmake-build-*/
CMakeCache.txt
CMakeFiles/
# 注意：无扩展名的 C++ 编译产物（如 ./main）不会被上面规则匹配，
#       可在对应项目文件夹里手动忽略，或养成把产物放进 build/ 的习惯。


# ---------- Java ----------
*.class
*.jar
*.war
target/
*.classpath
*.project
.settings/


# ---------- JavaScript / TypeScript (Node.js) ----------
node_modules/
npm-debug.log*
yarn-error.log*
dist/
.env


# ---------- Go ----------
*.test
*.out
vendor/


# ---------- Rust ----------
target/
Cargo.lock


# ---------- MATLAB ----------
*.asv
*.mex*
slprj/
octave-workspace


# ---------- LaTeX（笔记可能用到）----------
# 编译产生的中间文件
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg
# 想保留生成的 PDF 就不要加下面这行；通常 PDF 建议上传，故默认注释掉
# *.pdf


# ---------- 其他：大文件/压缩包/临时文件（按需开启）----------
# *.zip
# *.rar
# *.7z
# *.mp4
